+  // would overwrite that value, which another sibling may still reload.
+  LaneBitmask OrigLanes =
+      liveLanesAt(LIS.getInterval(Original), SrcVNI->def, MRI);
+  if ((OrigLanes & ~liveLanesAt(SrcLI, SrcVNI->def, MRI)).any())
+    return false;
