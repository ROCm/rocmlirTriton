#ifndef MLIR_CONVERSION_CPU_PASSES
#define MLIR_CONVERSION_CPU_PASSES

include "mlir/Pass/PassBase.td"

def CpuConvToGemmPass : Pass<"cpu-conv-to-gemm", "::mlir::ModuleOp"> {
  let summary = "Convert linalg.generic convolutions to matmul operations";
  let description = [{
    This pass identifies linalg.generic operations that represent convolutions
    and converts them to matrix multiplication operations using the im2col
    transformation.

    The pass currently supports:
    - Backward data convolution (computing input gradients)

    The transformation follows the im2col approach:
    1. Identify linalg.generic with convolution semantics based on indexing maps
    2. Create an im2col tensor that rearranges the input data
    3. Replace the convolution with a matmul (linalg.generic with GEMM semantics)
    4. Reshape results back to the expected output shape

    This transformation can improve performance by leveraging highly optimized
    GEMM implementations.
  }];
  let dependentDialects = [
    "func::FuncDialect",
    "linalg::LinalgDialect",
    "arith::ArithDialect",
    "tensor::TensorDialect"
  ];
}

def CpuLowerVerifierPass : Pass<"cpu-lower-verifier", "::mlir::ModuleOp"> {
  let summary = "Lower CPU verifier functions (i.e., functions marked with 'rock.cpu_verifier' attribute) to LLVM-compatible IR";
  let description = [{
    This pass specifically targets functions marked with the "rock.cpu_verifier"
    attribute. These functions are generated by rocmlir-gen for CPU-based
    verification of GPU kernel results.

    The pass uses the MLIR Transform Interpreter with an embedded transform
    sequence. It can run in two phases:
    - Phase 1 (default): Apply optimization transforms
    - Phase 2: Apply lowerToLLVM transforms

    This split allows running whole-module bufferization between phases,
    so that call sites are updated automatically by the bufferizer.
  }];
  let dependentDialects = [
    "func::FuncDialect",
    "memref::MemRefDialect",
    "bufferization::BufferizationDialect",
    "linalg::LinalgDialect",
    "arith::ArithDialect",
    "scf::SCFDialect",
    "affine::AffineDialect",
    "tensor::TensorDialect",
    "transform::TransformDialect"
  ];
  let options = [
    Option<"dumpSchedulesPath", "dump-schedules-path", "std::string", /*default=*/"\"\"",
           "Path to dump CPU verifier IR and transform schedules (empty = no dump)">,
    Option<"phase", "phase", "int", /*default=*/"1",
           "Which phase to run: 1 = CPU_PHASE_OPTIMIZE, 2 = CPU_PHASE_LOWERTOLLVM">
  ];
}

#endif // MLIR_CONVERSION_CPU_PASSES
