#!/bin/bash
#
# rocm-run: convenience wrapper around mlir-runner that auto-loads the shared
# libraries needed by rocMLIR-generated code (rocm runtime, conv validation
# wrappers, MLIR runner-utils, c-runner-utils, float16-utils).
#
# The rocMLIR build directory is located by:
#   1. Co-location: if this script lives next to rocmlir-driver (i.e. it has
#      been copied into a build's bin/ dir by CMake), use that directory.
#   2. A few well-known source-tree fallbacks.
#
# The matching LLVM build directory is then located by:
#   1. The in-tree LLVM build under <build>/external/llvm-project/llvm.
#   2. The LLVM_DIR entry in the rocMLIR build's CMakeCache.txt.
#
# This script must not fork before the final exec (no command substitutions,
# subshells, or pipes): rocprofv3 profiles it by LD_PRELOADing a library whose
# constructor spawns threads, and fork() in that state can deadlock the child
# on an inherited lock. Paths are therefore built by parameter expansion and
# left unnormalized (they may contain ".." segments).

SCRIPT_PATH="${BASH_SOURCE[0]}"
case "$SCRIPT_PATH" in
    */*) SCRIPT_DIR="${SCRIPT_PATH%/*}" ;;
    *)   SCRIPT_DIR="." ;;
esac
[[ "$SCRIPT_DIR" == /* ]] || SCRIPT_DIR="$PWD/$SCRIPT_DIR"

# Sets BASEDIR on success.
find_rocmlir_build() {
    # Co-located in <build>/bin/ (the cmake-installed location).
    if [[ -x "$SCRIPT_DIR/rocmlir-driver" ]]; then
        BASEDIR="$SCRIPT_DIR/.."
        return 0
    fi

    # Source-tree fallbacks (script in mlir/utils/widgets/).
    local repo_root="$SCRIPT_DIR/../../.."
    for dir in "$repo_root/build" "$PWD/.." "$PWD" "$PWD/build" \
               "$HOME/rocmlir/build"; do
        if [[ -x "$dir/bin/rocmlir-driver" ]]; then
            BASEDIR="$dir"
            return 0
        fi
    done

    echo "rocm-run: cannot locate rocMLIR build directory" >&2
    return 1
}

# Sets LLVM_BUILD on success.
find_llvm_build() {
    local rocmlir_build="$1"

    # Current monolithic layout: LLVM/MLIR tools and runtime libraries are built
    # under <build>/external/llvm-project/llvm.
    local in_tree_llvm="$rocmlir_build/external/llvm-project/llvm"
    if [[ -x "$in_tree_llvm/bin/mlir-runner" ]]; then
        LLVM_BUILD="$in_tree_llvm"
        return 0
    fi

    # Fall back to LLVM_DIR in CMakeCache.txt. Match "LLVM_DIR:" specifically
    # so we don't pick up "LLVM_DIR-ADVANCED:INTERNAL=1" if it appears first.
    local cache="$rocmlir_build/CMakeCache.txt"
    if [[ -f "$cache" ]]; then
        local line llvm_dir=""
        while IFS= read -r line; do
            case "$line" in
                LLVM_DIR:*=*) llvm_dir="${line#*=}"; break ;;
            esac
        done < "$cache"
        if [[ -n "$llvm_dir" ]]; then
            local candidate="$llvm_dir/../../.."
            if [[ -x "$candidate/bin/mlir-runner" ]]; then
                LLVM_BUILD="$candidate"
                return 0
            fi
        fi
    fi

    echo "rocm-run: cannot locate LLVM build directory" >&2
    return 1
}

find_rocmlir_build || exit 1
find_llvm_build "$BASEDIR" || exit 1

exec "${LLVM_BUILD}/bin/mlir-runner" \
    -O2 \
    "--shared-libs=${LLVM_BUILD}/lib/libmlir_rocm_runtime.so,${BASEDIR}/lib/libconv-validation-wrappers.so,${LLVM_BUILD}/lib/libmlir_runner_utils.so,${LLVM_BUILD}/lib/libmlir_float16_utils.so,${LLVM_BUILD}/lib/libmlir_c_runner_utils.so" \
    --entry-point-result=void \
    "$@"
