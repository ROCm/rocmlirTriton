#!/bin/bash

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Project root is 3 levels up from mlir/utils/widgets/
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

declare -g BASEDIR="none-such"
for dir in "$PROJECT_ROOT/build" "$PWD/.." "$PWD" "$PWD/build" \
                  "$HOME/rocmlir/build"; do
    if [[ -x "$dir/bin/rocmlir-driver" ]]; then
        BASEDIR="$dir"
        break
    fi
done

LLVM_BUILD="${PROJECT_ROOT}/external/triton/llvm-project/build"

exec "${LLVM_BUILD}/bin/mlir-runner" "-O2" "--shared-libs=${LLVM_BUILD}/lib/libmlir_rocm_runtime.so,${BASEDIR}/lib/libconv-validation-wrappers.so,${LLVM_BUILD}/lib/libmlir_runner_utils.so,${LLVM_BUILD}/lib/libmlir_float16_utils.so,${LLVM_BUILD}/lib/libmlir_c_runner_utils.so" --entry-point-result=void "$@"
