# grid=80 cluster (2nd round 14% full), tall-K GEMV-ish but compute-bound:
conv -F 1 -f GNC01 -I NGC01 -O NGC01 -n 1 -c 1536 -H 25 -W 25 -k 2048 -y 1 -x 1 -p 0 -q 0 -u 1 -v 1 -l 1 -j 1 -g 1  # 1.75 | 80 | 2048 | 625 | 1536 | 183
