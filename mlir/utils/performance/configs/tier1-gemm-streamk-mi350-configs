# Stream-K candidate subset of tier1-gemm-configs for MI350 (CDNA4, gfx950).
#
# Generated by gen-streamk-configs.py. Modelling the grid at the per-dimension
# efficient tile the tuner picks, tile(d) = min(128, next_pow2(d)),
#   grid = gemmG * ceil(gemmM / tile(gemmM)) * ceil(gemmN / tile(gemmN))   (num_cu = 256)
# a config is kept only when it (0) fills at least one output tile in each dim
# (gemmM >= 32 and gemmN >= 32, else it is a memory-bound GEMV that
# falls to split-K), (1) over-fills the machine (grid >= num_cu, so
# StreamKDecompose can build a P >= num_cu wave decomposition rather than bailing),
# (2) has a ragged tail -- imbalance = ceil(grid/num_cu)*num_cu/grid >=
# 1.20 -- (3) has splittable K (gemmK >= 256), and
# (4) has a buildable plan (chooseStreamKPlan succeeds for multiple 1 or 2 with
# remainder splitK <= 8).
# Underutilized / GEMV / memory-bound shapes are excluded: the pass can't
# decompose them (or gains nothing) and they fall to plain split-K instead.
# Eligible dtypes are those with fast
# atomic_add on this arch: f16, f32.
# See gen-streamk-configs.py for the full rationale.

-t f16 -out_datatype f16 -transA false -transB false -transO false -g 1 -m 2048 -n 5120 -k 640
-t f16 -out_datatype f16 -transA false -transB false -transO false -g 1 -m 512 -n 10240 -k 1280
-t f16 -out_datatype f16 -transA false -transB false -transO false -g 1 -m 4096 -n 1536 -k 512
-t f32 -out_datatype f32 -transA false -transB false -transO false -g 1 -m 256 -n 22016 -k 4096
-t f16 -out_datatype f16 -transA false -transB false -transO false -g 1 -m 256 -n 22016 -k 4096
-t f32 -out_datatype f32 -transA true -transB false -transO false -g 1 -m 1500 -n 3840 -k 1280
-t f32 -out_datatype f32 -transA false -transB false -transO false -g 1 -m 1500 -n 3840 -k 1280
-t f16 -out_datatype f16 -transA false -transB false -transO false -g 1 -m 216 -n 51865 -k 1280
