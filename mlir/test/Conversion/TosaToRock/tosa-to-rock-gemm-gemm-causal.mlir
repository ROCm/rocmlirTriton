// RUN: sed s/##TOKEN_ARCH##/%arch/g %s | rocmlir-opt --tosa-to-rock -verify-diagnostics -o -| FileCheck %s
// RUN: sed s/##TOKEN_ARCH##/%arch/g %s | rocmlir-driver -kernel-pipeline=highlevel,gpu | FileCheck %s --check-prefix=LOWER

// The causal kernel must also lower through the whole kernel pipeline: the
// gridwise verifier accepts causal without softmax, and both gemms survive
// down to TTIR.
// LOWER: tt.func @gemm_gemm_causal_zero_mask
// LOWER-COUNT-2: tt.dot
// LOWER: tt.func @gemm_gemm_zero_mask_arg_pred
// LOWER: tt.func @gemm_gemm_zero_mask_reversed_pred
// LOWER: tt.func @gemm_gemm_zero_mask_batched_col_range
// LOWER: tt.func @gemm_gemm_causal_zero_mask_arith_const
// LOWER: tt.func @gemm_gemm_causal_zero_mask_int_zero

// A causal mask that zeroes the upper triangle of the first gemm's result is
// lowered to the fused kernel's causal mode instead of staying a select in
// the elementwise region (zero is the additive identity of the second gemm).
// CHECK-LABEL: func @gemm_gemm_causal_zero_mask
// CHECK: rock.gemm_elementwise_gemm
// CHECK: causal
// CHECK-NOT: tosa.select
func.func @gemm_gemm_causal_zero_mask(%arg0: tensor<8x256x64xf16>, %arg1: tensor<8x64x256xf16>, %arg2: tensor<8x256x64xf16>) -> tensor<8x256x64xf16> attributes {rock.kernel, rock.arch = "##TOKEN_ARCH##"} {
  %a_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %b_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %scores = tosa.matmul %arg0, %arg1, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x64xf16>, tensor<8x64x256xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x256xf16>
  %scores_f = tosa.cast %scores : (tensor<8x256x256xf16>) -> tensor<8x256x256xf32>
  %cols = "tosa.const"() <{values = dense<""> : tensor<1x1x256xi32>}> : () -> tensor<1x1x256xi32>
  %rows = "tosa.const"() <{values = dense<""> : tensor<1x256x1xi32>}> : () -> tensor<1x256x1xi32>
  %pred = tosa.greater %cols, %rows : (tensor<1x1x256xi32>, tensor<1x256x1xi32>) -> tensor<1x256x256xi1>
  %zero = "tosa.const"() <{values = dense<0.0> : tensor<1x1x1xf32>}> : () -> tensor<1x1x1xf32>
  %masked = tosa.select %pred, %zero, %scores_f : (tensor<1x256x256xi1>, tensor<1x1x1xf32>, tensor<8x256x256xf32>) -> tensor<8x256x256xf32>
  %masked_h = tosa.cast %masked : (tensor<8x256x256xf32>) -> tensor<8x256x256xf16>
  %out = tosa.matmul %masked_h, %arg2, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x256xf16>, tensor<8x256x64xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x64xf16>
  return %out : tensor<8x256x64xf16>
}

// A select whose masked-out value is zero but whose predicate is not a
// compare of constant ranges stays in the elementwise region.
// CHECK-LABEL: func @gemm_gemm_zero_mask_arg_pred
// CHECK: rock.gemm_elementwise_gemm
// CHECK-NOT: causal
// CHECK: tosa.select
func.func @gemm_gemm_zero_mask_arg_pred(%arg0: tensor<8x256x64xf16>, %arg1: tensor<8x64x256xf16>, %arg2: tensor<8x256x64xf16>, %arg3: tensor<8x256x256xi8>) -> tensor<8x256x64xf16> attributes {rock.kernel, rock.arch = "##TOKEN_ARCH##"} {
  %a_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %b_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %scores = tosa.matmul %arg0, %arg1, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x64xf16>, tensor<8x64x256xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x256xf16>
  %scores_f = tosa.cast %scores : (tensor<8x256x256xf16>) -> tensor<8x256x256xf32>
  %pred = tosa.cast %arg3 : (tensor<8x256x256xi8>) -> tensor<8x256x256xi1>
  %zero = "tosa.const"() <{values = dense<0.0> : tensor<1x1x1xf32>}> : () -> tensor<1x1x1xf32>
  %masked = tosa.select %pred, %zero, %scores_f : (tensor<8x256x256xi1>, tensor<1x1x1xf32>, tensor<8x256x256xf32>) -> tensor<8x256x256xf32>
  %masked_h = tosa.cast %masked : (tensor<8x256x256xf32>) -> tensor<8x256x256xf16>
  %out = tosa.matmul %masked_h, %arg2, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x256xf16>, tensor<8x256x64xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x64xf16>
  return %out : tensor<8x256x64xf16>
}

// A reversed comparison, greater(rows, cols) = row > col, zeroes the lower
// triangle instead of the upper one. That is not a causal mask, so it must
// stay a select in the elementwise region rather than set causal.
// CHECK-LABEL: func @gemm_gemm_zero_mask_reversed_pred
// CHECK: rock.gemm_elementwise_gemm
// CHECK-NOT: causal
// CHECK: tosa.select
func.func @gemm_gemm_zero_mask_reversed_pred(%arg0: tensor<8x256x64xf16>, %arg1: tensor<8x64x256xf16>, %arg2: tensor<8x256x64xf16>) -> tensor<8x256x64xf16> attributes {rock.kernel, rock.arch = "##TOKEN_ARCH##"} {
  %a_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %b_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %scores = tosa.matmul %arg0, %arg1, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x64xf16>, tensor<8x64x256xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x256xf16>
  %scores_f = tosa.cast %scores : (tensor<8x256x256xf16>) -> tensor<8x256x256xf32>
  %cols = "tosa.const"() <{values = dense<""> : tensor<1x1x256xi32>}> : () -> tensor<1x1x256xi32>
  %rows = "tosa.const"() <{values = dense<""> : tensor<1x256x1xi32>}> : () -> tensor<1x256x1xi32>
  %pred = tosa.greater %rows, %cols : (tensor<1x256x1xi32>, tensor<1x1x256xi32>) -> tensor<1x256x256xi1>
  %zero = "tosa.const"() <{values = dense<0.0> : tensor<1x1x1xf32>}> : () -> tensor<1x1x1xf32>
  %masked = tosa.select %pred, %zero, %scores_f : (tensor<1x256x256xi1>, tensor<1x1x1xf32>, tensor<8x256x256xf32>) -> tensor<8x256x256xf32>
  %masked_h = tosa.cast %masked : (tensor<8x256x256xf32>) -> tensor<8x256x256xf16>
  %out = tosa.matmul %masked_h, %arg2, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x256xf16>, tensor<8x256x64xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x64xf16>
  return %out : tensor<8x256x64xf16>
}


// The column range carries an extra non-one dimension at index 0 (2x1x256),
// which is not the splitKV flash-decoding layout, so the range check must
// reject it rather than treat a batched range as a plain column range.
// CHECK-LABEL: func @gemm_gemm_zero_mask_batched_col_range
// CHECK: rock.gemm_elementwise_gemm
// CHECK-NOT: causal
// CHECK: tosa.select
func.func @gemm_gemm_zero_mask_batched_col_range(%arg0: tensor<2x256x64xf16>, %arg1: tensor<2x64x256xf16>, %arg2: tensor<2x256x64xf16>) -> tensor<2x256x64xf16> attributes {rock.kernel, rock.arch = "##TOKEN_ARCH##"} {
  %a_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %b_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %scores = tosa.matmul %arg0, %arg1, %a_zp, %b_zp {acc_type = f32} : (tensor<2x256x64xf16>, tensor<2x64x256xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<2x256x256xf16>
  %scores_f = tosa.cast %scores : (tensor<2x256x256xf16>) -> tensor<2x256x256xf32>
  %cols = "tosa.const"() <{values = dense<""> : tensor<2x1x256xi32>}> : () -> tensor<2x1x256xi32>
  %rows = "tosa.const"() <{values = dense<""> : tensor<1x256x1xi32>}> : () -> tensor<1x256x1xi32>
  %pred = tosa.greater %cols, %rows : (tensor<2x1x256xi32>, tensor<1x256x1xi32>) -> tensor<2x256x256xi1>
  %zero = "tosa.const"() <{values = dense<0.0> : tensor<1x1x1xf32>}> : () -> tensor<1x1x1xf32>
  %masked = tosa.select %pred, %zero, %scores_f : (tensor<2x256x256xi1>, tensor<1x1x1xf32>, tensor<2x256x256xf32>) -> tensor<2x256x256xf32>
  %masked_h = tosa.cast %masked : (tensor<2x256x256xf32>) -> tensor<2x256x256xf16>
  %out = tosa.matmul %masked_h, %arg2, %a_zp, %b_zp {acc_type = f32} : (tensor<2x256x256xf16>, tensor<2x256x64xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<2x256x64xf16>
  return %out : tensor<2x256x64xf16>
}

// Same causal mask, but the zero splat is an arith.constant instead of a
// tosa.const.
// CHECK-LABEL: func @gemm_gemm_causal_zero_mask_arith_const
// CHECK: rock.gemm_elementwise_gemm
// CHECK: causal
// CHECK-NOT: tosa.select
func.func @gemm_gemm_causal_zero_mask_arith_const(%arg0: tensor<8x256x64xf16>, %arg1: tensor<8x64x256xf16>, %arg2: tensor<8x256x64xf16>) -> tensor<8x256x64xf16> attributes {rock.kernel, rock.arch = "##TOKEN_ARCH##"} {
  %a_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %b_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %scores = tosa.matmul %arg0, %arg1, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x64xf16>, tensor<8x64x256xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x256xf16>
  %scores_f = tosa.cast %scores : (tensor<8x256x256xf16>) -> tensor<8x256x256xf32>
  %cols = "tosa.const"() <{values = dense<""> : tensor<1x1x256xi32>}> : () -> tensor<1x1x256xi32>
  %rows = "tosa.const"() <{values = dense<""> : tensor<1x256x1xi32>}> : () -> tensor<1x256x1xi32>
  %pred = tosa.greater %cols, %rows : (tensor<1x1x256xi32>, tensor<1x256x1xi32>) -> tensor<1x256x256xi1>
  %zero = arith.constant dense<0.000000e+00> : tensor<1x1x1xf32>
  %masked = tosa.select %pred, %zero, %scores_f : (tensor<1x256x256xi1>, tensor<1x1x1xf32>, tensor<8x256x256xf32>) -> tensor<8x256x256xf32>
  %masked_h = tosa.cast %masked : (tensor<8x256x256xf32>) -> tensor<8x256x256xf16>
  %out = tosa.matmul %masked_h, %arg2, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x256xf16>, tensor<8x256x64xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x64xf16>
  return %out : tensor<8x256x64xf16>
}

// Same causal mask, but the zero splat is an integer constant reached through
// a cast.
// CHECK-LABEL: func @gemm_gemm_causal_zero_mask_int_zero
// CHECK: rock.gemm_elementwise_gemm
// CHECK: causal
// CHECK-NOT: tosa.select
func.func @gemm_gemm_causal_zero_mask_int_zero(%arg0: tensor<8x256x64xf16>, %arg1: tensor<8x64x256xf16>, %arg2: tensor<8x256x64xf16>) -> tensor<8x256x64xf16> attributes {rock.kernel, rock.arch = "##TOKEN_ARCH##"} {
  %a_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %b_zp = "tosa.const"() <{values = dense<0.0> : tensor<1xf16>}> : () -> tensor<1xf16>
  %scores = tosa.matmul %arg0, %arg1, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x64xf16>, tensor<8x64x256xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x256xf16>
  %scores_f = tosa.cast %scores : (tensor<8x256x256xf16>) -> tensor<8x256x256xf32>
  %cols = "tosa.const"() <{values = dense<""> : tensor<1x1x256xi32>}> : () -> tensor<1x1x256xi32>
  %rows = "tosa.const"() <{values = dense<""> : tensor<1x256x1xi32>}> : () -> tensor<1x256x1xi32>
  %pred = tosa.greater %cols, %rows : (tensor<1x1x256xi32>, tensor<1x256x1xi32>) -> tensor<1x256x256xi1>
  %zero_i = "tosa.const"() <{values = dense<0> : tensor<1x1x1xi32>}> : () -> tensor<1x1x1xi32>
  %zero = tosa.cast %zero_i : (tensor<1x1x1xi32>) -> tensor<1x1x1xf32>
  %masked = tosa.select %pred, %zero, %scores_f : (tensor<1x256x256xi1>, tensor<1x1x1xf32>, tensor<8x256x256xf32>) -> tensor<8x256x256xf32>
  %masked_h = tosa.cast %masked : (tensor<8x256x256xf32>) -> tensor<8x256x256xf16>
  %out = tosa.matmul %masked_h, %arg2, %a_zp, %b_zp {acc_type = f32} : (tensor<8x256x256xf16>, tensor<8x256x64xf16>, tensor<1xf16>, tensor<1xf16>) -> tensor<8x256x64xf16>
  return %out : tensor<8x256x64xf16>
}
