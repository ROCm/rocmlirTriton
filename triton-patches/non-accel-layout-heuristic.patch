+    // CHECK-DAG: %[[B:.+]] = ttg.convert_layout {{.*}} -> tensor<64x128xf32, #ttg.dot_op<{opIdx = 1, parent = #[[BAL4]]}>>
+    // CHECK-DAG: %[[C:.+]] = ttg.convert_layout {{.*}} -> tensor<128x128xf32, #[[BAL4]]>
