+    // CHECK-DAG: %[[B:.+]] = ttg.convert_layout {{.*}} -> tensor<64x256xf32, #ttg.dot_op<{opIdx = 1, parent = #[[BAL3]]}>>
+    // CHECK-DAG: %[[C:.+]] = ttg.convert_layout {{.*}} -> tensor<64x256xf32, #[[BAL3]]>
