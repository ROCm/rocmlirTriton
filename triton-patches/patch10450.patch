diff --git a/third_party/amd/lib/TritonAMDGPUTransforms/AnnotateBufferOpSplitSafety.cpp b/third_party/amd/lib/TritonAMDGPUTransforms/AnnotateBufferOpSplitSafety.cpp
--- a/third_party/amd/lib/TritonAMDGPUTransforms/AnnotateBufferOpSplitSafety.cpp
+++ b/third_party/amd/lib/TritonAMDGPUTransforms/AnnotateBufferOpSplitSafety.cpp
@@ -24,7 +24,14 @@
 // Conservatively accept an offset only when every leaf in its
 // additive/shape expression proves non-negative. This may miss safe splits,
 // but never annotates an offset with a possibly-negative voffset.
 static bool isLeafNonNegative(Value v, DataFlowSolver &solver) {
+  // An `add` is never a leaf to the soffset splitter. It peels the summands
+  // apart and lifts the uniform ones into the unsigned soffset. So a sum whose
+  // range is non-negative can still hide a negative summand.
+  if (Operation *def = v.getDefiningOp())
+    if (isa<arith::AddIOp>(def))
+      return false;
+
   const auto *range = solver.lookupState<dataflow::IntegerValueRangeLattice>(v);
   if (!range || range->getValue().isUninitialized())
     return false;
diff --git a/test/TritonGPU/amd/amd-annotate-buffer-op-split-safety.mlir b/test/TritonGPU/amd/amd-annotate-buffer-op-split-safety.mlir
new file mode 100644
--- /dev/null
+++ b/test/TritonGPU/amd/amd-annotate-buffer-op-split-safety.mlir
@@ -0,0 +1,37 @@
+// RUN: triton-opt %s -split-input-file --tritonamdgpu-annotate-buffer-op-split-safety | FileCheck %s
+
+// All additive leaves of the offset are provably non-negative (make_range
+// start >= 0 and a positive splat constant), so lifting the uniform leaf
+// into soffset is safe and the op is annotated.
+#blocked0 = #ttg.blocked<{sizePerThread = [4], threadsPerWarp = [32], warpsPerCTA = [1], order = [0]}>
+module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 1 : i32} {
+  // CHECK-LABEL: @all_leaves_nonneg_is_split_safe
+  tt.func @all_leaves_nonneg_is_split_safe(%arg0: !tt.ptr<f32> {tt.divisibility = 16 : i32}) {
+    %range = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32, #blocked0>
+    %c16 = arith.constant dense<16> : tensor<128xi32, #blocked0>
+    %offset = arith.addi %range, %c16 : tensor<128xi32, #blocked0>
+    // CHECK: amdg.buffer_load %arg0[%{{.*}}] {amdgpu.split_soffset_safe}
+    %ret = amdg.buffer_load %arg0[%offset] : tensor<128xf32, #blocked0>
+    tt.return
+  }
+}
+
+// -----
+
+// Regression: the composite offset is provably non-negative (range
+// [0, 127]), but it decomposes into a non-negative make_range leaf plus a
+// negative constant leaf (-29, e.g. a convolution padding shift). That
+// negative leaf would be lifted into the unsigned soffset and OOB-drop
+// every lane, so the op must NOT be annotated as split-safe.
+#blocked0 = #ttg.blocked<{sizePerThread = [4], threadsPerWarp = [32], warpsPerCTA = [1], order = [0]}>
+module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 1 : i32} {
+  // CHECK-LABEL: @negative_leaf_not_split_safe
+  tt.func @negative_leaf_not_split_safe(%arg0: !tt.ptr<f32> {tt.divisibility = 16 : i32}) {
+    %range = tt.make_range {end = 157 : i32, start = 29 : i32} : tensor<128xi32, #blocked0>
+    %cneg = arith.constant dense<-29> : tensor<128xi32, #blocked0>
+    %offset = arith.addi %range, %cneg : tensor<128xi32, #blocked0>
+    // CHECK-NOT: amdgpu.split_soffset_safe
+    %ret = amdg.buffer_load %arg0[%offset] : tensor<128xf32, #blocked0>
+    tt.return
+  }
+}
